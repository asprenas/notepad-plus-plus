[Desktop Entry]
Type=Application
Name=Notepad++ Qt
GenericName=Text Editor
Comment=Source code editor (Qt port of Notepad++)
Exec=notepadpp-qt %F
Icon=notepadpp-qt
Terminal=false
StartupNotify=true
StartupWMClass=notepadpp-qt
Categories=Utility;TextEditor;
Keywords=text;editor;code;notepad;
MimeType=text/plain;text/x-log;text/markdown;text/x-csrc;text/x-chdr;text/x-c++src;text/x-c++hdr;text/x-csharp;text/x-java;text/x-python;text/x-python3;text/x-perl;text/x-ruby;text/x-lua;text/x-go;text/rust;text/x-makefile;text/x-cmake;text/x-sql;text/x-tex;text/x-diff;text/x-patch;text/css;text/html;text/xml;text/javascript;text/x-ini;application/x-shellscript;application/javascript;application/json;application/xml;application/x-yaml;application/x-php;application/x-desktop;application/sql;
Actions=new-window;

[Desktop Action new-window]
Name=New Instance
Exec=notepadpp-qt -multiInst
